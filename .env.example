# ==============================================================================
# ThermoShield India - Production Real-Time Upgrade Environment Config
# ==============================================================================

# 1. Official India Meteorological Department (IMD) AWS Telemetry API
# Provides direct ground-truth calibration against 550+ IMD automated weather stations
IMD_API_ENDPOINT=https://mausam.imd.gov.in/api/v1/aws_realtime
IMD_API_KEY=your_imd_api_key_or_bearer_token_here

# 2. Google Earth Engine (GEE) - Satellite Land Surface Temperature (LST) & NDVI
# Enables 30m-100m spatial resolution Urban Heat Island (UHI) mapping
GEE_SERVICE_ACCOUNT=your_service_account@your-gcp-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./credentials/gee-service-account.json

# 3. Mass Civic Alert Gateway (NDMA Cell Broadcast & WhatsApp Business)
# Enables automated vernacular SMS/WhatsApp pushes without requiring app installation
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
WHATSAPP_SENDER_NUMBER=+14155238886

# Alternative Indian Vernacular Gateway (Gupshup Enterprise)
GUPSHUP_API_KEY=your_gupshup_api_key

# 4. Core Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
