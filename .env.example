# ==============================================================================
# ThermoShield India - Real-Time Meteorological & Biometeorological Config
# ==============================================================================

# 1. Primary Live Weather Engine (Open-Meteo - 100% Free, No API Key Required)
# Streams live dry-bulb temperature, relative humidity, wind speed, solar irradiance,
# dew point, and 7-day hourly forecasts directly with ZERO API key or billing required.
WEATHER_PROVIDER=open-meteo
OPEN_METEO_API_ENDPOINT=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_ENDPOINT=https://geocoding-api.open-meteo.com/v1/search

# 2. India Meteorological Department (IMD) Ground AWS Telemetry (OPTIONAL - DISABLED)
# Not required. Open-Meteo powers all live temperature and biometeorological risk models.
ENABLE_IMD_GATEWAY=false
# IMD_API_ENDPOINT=https://mausam.imd.gov.in/api/v1/aws_realtime
# IMD_API_KEY=

# 3. Google Earth Engine (GEE) - Satellite Land Surface Temperature (Optional)
GEE_SERVICE_ACCOUNT=your_service_account@your-gcp-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./credentials/gee-service-account.json

# 4. Civic Alert Gateway (NDMA Cell Broadcast / WhatsApp - Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_SENDER_NUMBER=+14155238886
GUPSHUP_API_KEY=

# 5. Core Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
